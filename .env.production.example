# Env vars required/read by config/settings_production.py
# (DJANGO_SETTINGS_MODULE=config.settings_production)
#
# Unlike .env.example, there are NO working defaults here for
# DJANGO_SECRET_KEY or ALLOWED_HOSTS — config/settings_production.py has no
# fallback for either, so a real deployment must set them explicitly or the
# app will refuse to start (ImproperlyConfigured).
#
# DEBUG is not read from the environment in production — it is hardcoded to
# False in config/settings_production.py and cannot be re-enabled via env var.

# REQUIRED. No default. Generate a real secret, e.g.:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# REQUIRED. No default. Comma-separated list of the domain(s)/host(s) this
# deployment is served from, e.g.:
# ALLOWED_HOSTS=maintenance.example-hotel.com
ALLOWED_HOSTS=

# Database connection. Point these at the production Postgres instance.
DB_NAME=hotel_maintenance
DB_USER=hotel_maintenance
DB_PASSWORD=change-me
DB_HOST=change-me
DB_PORT=5432
